# Settings of Open WebUI for a group of young people (part 3 of the guide).
# Open WebUI saves most of them in its own data at its very first start. After that, changing this
# file has no effect on them, even when you start Open WebUI again: use the Admin Panel instead.
# So edit this file (for example, translate the banner at the end) BEFORE the first start.
# Taken from the settings of the workshop kit's openwebui command, without its Codespace and API
# key parts.

# Nothing sent out by Open WebUI itself: no update checks, no statistics, no web search.
OFFLINE_MODE=true
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
ENABLE_WEB_SEARCH=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_CODE_INTERPRETER=false

# Only the local models of Ollama, no AI company.
ENABLE_OPENAI_API=false

# The document search keeps the settings of Open WebUI, the ones we measured with: 3 passages per
# question, and the model rewrites the question before the search.

# No other hidden questions to the model (titles, tags, suggestions): less waiting for the group.
ENABLE_TITLE_GENERATION=false
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false

# Participants cannot change a chatbot's instructions or settings, nor chat with several models.
USER_PERMISSIONS_CHAT_SYSTEM_PROMPT=false
USER_PERMISSIONS_CHAT_PARAMS=false
USER_PERMISSIONS_CHAT_MULTIPLE_MODELS=false
USER_PERMISSIONS_CHAT_CONTROLS=false

# No temporary chats: every conversation is saved (participants can still delete theirs), so that
# you can count the questions and read the feedback. The participant notice says who can read them.
USER_PERMISSIONS_CHAT_TEMPORARY=false

# No files or photos of their own, no voice recordings, no sharing of conversations.
# These hide the buttons: they are not a lock.
USER_PERMISSIONS_CHAT_FILE_UPLOAD=false
USER_PERMISSIONS_CHAT_WEB_UPLOAD=false
USER_PERMISSIONS_CHAT_STT=false
USER_PERMISSIONS_CHAT_CALL=false
USER_PERMISSIONS_CHAT_SHARE=false

# Participants do not see the administrator's name and e-mail.
SHOW_ADMIN_DETAILS=false

# A sign-in lasts 12 hours (4 weeks by default): on a shared tablet, the next young person does not
# find the previous one's account the next day.
JWT_EXPIRES_IN=12h

# The sign-in key is kept with the data: starting Open WebUI again (part 6) does not sign everyone out.
WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key

# A simpler menu.
ENABLE_NOTES=false
ENABLE_CALENDAR=false
WEBUI_NAME=Group chatbots
WEBUI_BANNERS=[{"id":"no-personal-data","type":"info","dismissible":false,"timestamp":0,"content":"Do not write personal information (yours or anyone else's) in your questions."}]
